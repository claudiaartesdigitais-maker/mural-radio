<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <style>
    body, html { margin: 0; padding: 0; background: #001220; overflow: hidden; font-family: Arial, sans-serif; }
    
    .header { 
      background: #001a33; color: #ffcc00; text-align: center; 
      padding: 10px; font-weight: bold; font-size: 18px; 
      border-bottom: 2px solid #ffcc00; margin-bottom: 10px;
    }

    .swiper { width: 100%; height: 380px; }
    .swiper-slide { display: flex; justify-content: center; align-items: center; width: auto; }

    .card { position: relative; display: block; text-decoration: none; cursor: pointer; }

    img, video {
      height: 340px; width: auto; border-radius: 12px;
      box-shadow: 0 6px 15px rgba(0,0,0,0.6); display: block;
    }

    video { background: #000; min-width: 250px; }

    .link-indicator {
      position: absolute; bottom: 20px; right: 20px;
      background: #ffcc00; color: #001a33; padding: 8px 12px; 
      border-radius: 8px; font-size: 11px; font-weight: bold;
    }
  </style>
</head>
<body>

  <div class="header">MURAL DA SEMANA</div>

  <div class="swiper">
    <div class="swiper-wrapper" id="listaMural">
       </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script>
    // Link do seu Google Script (que já testamos e está enviando os dados)
    const urlScript = 'https://script.google.com/macros/s/AKfycbysy1A5r5Qr-kxIqPfNLabVKA6ojJHSYcn6ZnZUR6LwxwPMnmaQGAO7VZzAKkarIP_J3A/exec';

    async function carregarDados() {
      try {
        const res = await fetch(urlScript);
        const dados = await res.json();
        const container = document.getElementById("listaMural");
        container.innerHTML = "";

        dados.forEach(item => {
          const slide = document.createElement("div");
          slide.className = "swiper-slide";
          
          let midiaHtml = "";
          const linkDaFotoOuVideo = item.foto || "";
          
          // Se o link termina em .mp4, cria um player de vídeo
          if (linkDaFotoOuVideo.toLowerCase().includes(".mp4")) {
            midiaHtml = `<video controls playsinline preload="metadata">
                           <source src="${linkDaFotoOuVideo}" type="video/mp4">
                         </video>`;
          } else {
            // Caso contrário, cria uma imagem normal
            midiaHtml = `<img src="${linkDaFotoOuVideo}" alt="Mural">`;
          }

          const temLink = item.link && item.link.length > 5;
          const indicator = temLink ? `<div class="link-indicator">🔗 Abrir Link</div>` : "";

          slide.innerHTML = temLink 
            ? `<a href="${item.link}" target="_top" class="card">${midiaHtml}${indicator}</a>`
            : `<div class="card">${midiaHtml}</div>`;
          
          container.appendChild(slide);
        });

        // Inicializa o carrossel depois que os itens foram carregados
        new Swiper('.swiper', {
          slidesPerView: 'auto',
          spaceBetween: 20,
          centeredSlides: true,
          loop: dados.length > 1,
          autoplay: { delay: 5000, disableOnInteraction: true }
        });

      } catch (e) {
        console.error("Erro ao carregar:", e);
      }
    }

    carregarDados();
  </script>
</body>
</html>
