<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <style>
    body, html { margin: 0; padding: 0; background: transparent; overflow: hidden; font-family: sans-serif; }
    .header-container { background: #001a33; color: #ffcc00; text-align: center; padding: 12px 0; border-bottom: 3px solid #ffcc00; margin-bottom: 15px; }
    .title { font-weight: bold; font-size: 18px; text-transform: uppercase; margin: 0; }
    .swiper { width: 100%; height: 420px; }
    .swiper-slide { display: flex; justify-content: center; align-items: center; width: auto; }
    .card { position: relative; border-radius: 15px; overflow: hidden; background: #000; box-shadow: 0 8px 20px rgba(0,0,0,0.5); border: 1px solid #333; }
    img, video { height: 370px; width: auto; display: block; object-fit: contain; }
  </style>
</head>
<body>
  <div class="header-container"><div class="title">Mural da Semana</div></div>
  <div class="swiper"><div class="swiper-wrapper" id="track"></div></div>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script>
    const urlScript = 'https://script.google.com/macros/s/AKfycbxGq4FPn7DkbnlEA3fHXlng5RvFkJSWmR04dq-WlSxAGMeSKfzYID1od30bzTBZ0ThxFA/exec';

    async function carregarMural() {
      try {
        const resposta = await fetch(urlScript);
        const dados = await resposta.json();
        const track = document.getElementById("track");
        
        if (!dados || dados.length === 0) return;

        track.innerHTML = dados.map(item => {
          const midiaUrl = item.arquivo || "";
          const isVideo = /\.(mp4|webm|mov)$/i.test(midiaUrl);
          const midiaHtml = isVideo 
            ? `<video src="${midiaUrl}" controls playsinline style="height:370px"></video>`
            : `<img src="${midiaUrl}">`;

          return `
            <div class="swiper-slide">
              <a href="${item.link || '#'}" target="_top" class="card">${midiaHtml}</a>
            </div>`;
        }).join('');

        new Swiper('.swiper', {
          slidesPerView: 'auto',
          spaceBetween: 25,
          centeredSlides: true,
          loop: dados.length > 1,
          grabCursor: true
        });
      } catch (e) { console.error(e); }
    }
    carregarMural();
  </script>
</body>
</html>
