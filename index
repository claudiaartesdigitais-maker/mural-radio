<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <style>
    body, html { margin: 0; padding: 0; background: transparent; overflow: hidden; font-family: sans-serif; }
    
    .header-container {
      background: #001a33; 
      color: #ffcc00; 
      text-align: center; 
      padding: 12px 0;
      border-bottom: 3px solid #ffcc00;
      margin-bottom: 15px;
    }

    .title { font-weight: bold; font-size: 18px; text-transform: uppercase; margin: 0; }
    
    .drag-instruction { 
      font-size: 14px; 
      color: #ffffff; 
      margin-top: 6px;
      letter-spacing: 2px;
      font-weight: bold; 
      display: block;
      text-align: center;
      animation: pulse 2s infinite; 
    }

    @keyframes pulse { 0% { opacity: 0.6; } 50% { opacity: 1; } 100% { opacity: 0.6; } }

    .swiper { width: 100%; height: 420px; }
    .swiper-slide { display: flex; justify-content: center; align-items: center; width: auto; }

    .card { 
      position: relative; 
      border-radius: 15px; 
      overflow: hidden; 
      background: #000; 
      box-shadow: 0 8px 20px rgba(0,0,0,0.5);
      border: 1px solid #333;
      display: block;
      text-decoration: none;
    }

    img, video { height: 370px; width: auto; display: block; object-fit: contain; }

    .link-indicator { 
      position: absolute; 
      bottom: 20px; 
      right: 15px; 
      background: #ffcc00; 
      color: #001a33; 
      padding: 10px 18px; 
      border-radius: 10px; 
      font-size: 14px; 
      font-weight: 900; 
      z-index: 10;
      box-shadow: 0 4px 10px rgba(0,0,0,0.4);
      text-transform: uppercase;
    }
  </style>
</head>
<body>

  <div class="header-container">
    <div class="title">Mural da Semana</div>
    <div class="drag-instruction">&lt; ARRASTE PARA VER MAIS &gt;</div>
  </div>

  <div class="swiper">
    <div class="swiper-wrapper" id="track">
       <p style="color:white; text-align:center; width:100%;">Carregando...</p>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script>
    // SEU NOVO LINK DO SCRIPT (JÁ CONFIGURADO)
    const urlScript = 'https://script.google.com/macros/s/AKfycbxGq4FPn7DkbnlEA3fHXlng5RvFkJSWmR04dq-WlSxAGMeSKfzYID1od30bzTBZ0ThxFA/exec';

    async function carregarMural() {
      try {
        const resposta = await fetch(urlScript);
        const dados = await resposta.json();
        const track = document.getElementById("track");
        
        if (!dados || dados.length === 0) {
          track.innerHTML = "<p style='color:white; text-align:center; width:100%;'>Nenhum item ativo.</p>";
          return;
        }

        track.innerHTML = dados.map(item => {
          const midiaUrl = item.arquivo || "";
          const isVideo = /\.(mp4|webm|mov)$/i.test(midiaUrl);
          
          const midiaHtml = isVideo 
            ? `<video src="${midiaUrl}" controls playsinline preload="metadata"></video>`
            : `<img src="${midiaUrl}" alt="Mural">`;

          const temLink = item.link && item.link.length > 5;

          return `
            <div class="swiper-slide">
              <a href="${temLink ? item.link : 'javascript:void(0)'}" target="_top" class="card">
                ${midiaHtml}
                ${temLink ? `<div class="link-indicator">🔗 VER MAIS</div>` : ''}
              </a>
            </div>`;
        }).join('');

        new Swiper('.swiper', {
          slidesPerView: 'auto',
          spaceBetween: 25,
          centeredSlides: true,
          loop: dados.length > 1,
          grabCursor: true
        });

      } catch (e) {
        console.error("Erro:", e);
        document.getElementById("track").innerHTML = "<p style='color:white;'>Erro ao carregar dados.</p>";
      }
    }

    carregarMural();
  </script>
</body>
</html>
