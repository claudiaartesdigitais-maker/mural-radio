<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <base target="_top">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <style>
    body, html { margin: 0; padding: 0; background: #001220; overflow: hidden; font-family: Arial, sans-serif; }
    
    .header { 
      background: #001a33; 
      color: #ffcc00; 
      text-align: center; 
      padding: 10px; 
      font-weight: bold; 
      font-size: 18px; 
      border-bottom: 2px solid #ffcc00;
      margin-bottom: 10px;
    }

    .swiper { width: 100%; height: 380px; }

    .swiper-slide {
      display: flex;
      justify-content: center;
      align-items: center;
      width: auto;
    }

    .card {
      position: relative;
      display: block;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
      cursor: pointer;
    }

    img, video {
      height: 340px; 
      width: auto;
      border-radius: 12px;
      box-shadow: 0 6px 15px rgba(0,0,0,0.6);
      display: block;
      transition: transform 0.2s;
    }

    video { background: #000; min-width: 200px; }

    .card:active img, .card:active video { transform: scale(0.96); }

    .link-indicator {
      position: absolute;
      bottom: 20px;
      right: 20px;
      background: rgba(255, 204, 0, 0.95);
      color: #001a33;
      padding: 8px 12px; 
      border-radius: 8px;
      font-size: 11px;
      font-weight: bold;
      text-transform: uppercase;
      pointer-events: none;
    }
  </style>
</head>
<body>

  <div class="header">MURAL DA SEMANA</div>

  <div class="swiper">
    <div class="swiper-wrapper" id="track"></div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script>
    // Link do Script que você enviou agora:
    const urlScript = 'https://script.google.com/macros/s/AKfycbysy1A5r5Qr-kxIqPfNLabVKA6ojJHSYcn6ZnZUR6LwxwPMnmaQGAO7VZzAKkarIP_J3A/exec';

    async function carregarMural() {
      try {
        const resposta = await fetch(urlScript);
        const dados = await resposta.json();
        const track = document.getElementById("track");
        
        if (!dados || dados.length === 0) { 
          track.innerHTML = "<p style='color:#fff; padding:20px;'>Nenhuma novidade no momento.</p>"; 
          return; 
        }
        
        const htmlFotos = dados.map(item => {
          let conteudoMidia = '';
          const urlMidia = item.foto || "";
          // Verifica se o link contém .mp4 (independente de maiúsculas ou minúsculas)
          const eVideo = urlMidia.toLowerCase().includes('.mp4');

          if (eVideo) {
            conteudoMidia = `<video controls playsinline preload="metadata">
                               <source src="${urlMidia}" type="video/mp4">
                             </video>`;
          } else {
            conteudoMidia = `<img src="${urlMidia}" alt="Mídia Mural">`;
          }

          const temLink = item.link && item.link.toString().trim().length > 5;
          const indicator = temLink ? `<div class="link-indicator">🔗 Abrir Link</div>` : "";
          
          if (temLink) {
             return `<div class="swiper-slide"><a href="${item.link}" target="_top" class="card">${conteudoMidia}${indicator}</a></div>`;
          }
          return `<div class="swiper-slide"><div class="card">${conteudoMidia}</div></div>`;
        }).join('');

        track.innerHTML = htmlFotos;

        new Swiper('.swiper', {
          slidesPerView: 'auto',
          spaceBetween: 25,
          centeredSlides: true,
          loop: dados.length > 1,
          grabCursor: true,
          autoplay: {
            delay: 5000,
            disableOnInteraction: true,
          }
        });

      } catch (erro) {
        console.error("Erro ao carregar:", erro);
        document.getElementById("track").innerHTML = "<p style='color:white;'>Erro ao carregar dados.</p>";
      }
    }

    carregarMural();
  </script>
</body>
</html>
